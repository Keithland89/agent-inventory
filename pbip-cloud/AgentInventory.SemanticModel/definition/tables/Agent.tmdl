		annotation UnderlyingDateTimeDataType = Date

	/// What kind of principal owns the agent. Agents whose owner id does not resolve to a directory object - deleted users, cross-tenant guests, or system identities Graph will not return - are labelled rather than left blank.
	column OwnerPrincipalType = VAR p = RELATED ( 'User'[PrincipalType] ) RETURN IF ( ISBLANK ( p ) || p = "", "Not resolved in Entra", p )
		dataType: string
		lineageTag: 32a87696-6cb1-435a-afd6-f5daec977b45
		summarizeBy: none

	/// Whether a person authored the agent, the platform provisioned it automatically, or no creator was recorded at all. Most tenants are dominated by platform-provisioned agents - default environment scaffolding, template copies and system bots - which drown out real human activity, so this is offered as a slicer on every page. Note that an unresolved creator arrives as an empty string rather than BLANK, so both must be tested.
	column AgentOrigin = VAR creator = 'Agent'[CreatedByName] RETURN IF ( ISBLANK ( creator ) || creator = "", "Creator unknown", IF ( creator = "System / platform", "Platform-provisioned", "Human-built" ) )
		dataType: string
		lineageTag: cbe820c3-3e26-4051-a3af-893eb81916d0
		summarizeBy: none

	/// The agent's own Entra identity, shown in the Agent 365 registry as "Entra agent ID". This is not the same value as EntraAppId, which is the app registration behind the agent.
	column EntraAgentId
		dataType: string
		lineageTag: 5c1f8a02-7d43-4b96-9e21-a4c6f0b17d38
		summarizeBy: none
		sourceColumn: EntraAgentId

	/// Identifies the blueprint an agent was instantiated from, so sibling agents built from the same Microsoft template can be grouped.
	column EntraAgentBlueprintId
		dataType: string
		isHidden
