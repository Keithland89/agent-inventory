		sourceColumn: CreatedBy

	/// Display name of the agent's creator, resolved from Entra ID via Microsoft Graph directoryObjects/getByIds.
	column CreatedByName = IF ( 'Agent'[CreatedBy] = "00000000-0000-0000-0000-000000000000", "System / platform", LOOKUPVALUE ( 'User'[DisplayName], 'User'[UserKey], 'Agent'[CreatedBy] ) )
		dataType: string
		lineageTag: e0f9ed43-0d4b-4fd9-98e3-0cbc74789ff9
		summarizeBy: none

	/// Display name of the agent's current owner.
	column OwnerName = IF ( 'Agent'[OwnerId] = "00000000-0000-0000-0000-000000000000", "System / platform", RELATED ( 'User'[DisplayName] ) )
		dataType: string
		lineageTag: e58a41f4-f088-4893-81f8-e15e7bb9747a
		summarizeBy: none

	/// User principal name of the owner, where the identity resolved to a user.
	column OwnerUpn = RELATED ( 'User'[UserPrincipalName] )
		dataType: string
		lineageTag: 1609e37a-2e2d-4e90-bc3c-b85205b989c2
