/// Which monitoring signals are actually obtainable for each agent platform without an Agent 365 licence. This is what makes the usage gaps on the Usage page explainable rather than mysterious.
table TelemetryCoverage
	lineageTag: ca395ccd-668c-4079-9ab8-ed29b997cbdc

	column SortOrder
		dataType: int64
		isHidden
		lineageTag: 4317b24f-dff1-46e6-9585-accb73fde509
		sourceColumn: SortOrder

	column Platform
		dataType: string
		lineageTag: 40e66246-dc4d-4411-b498-a9a6c6f0af06
		sourceColumn: Platform
		sortByColumn: SortOrder

	column Inventory
		dataType: string
		lineageTag: ecca751a-73fb-4809-ad70-be34dc0eb6c9
		sourceColumn: Inventory

	column Configuration
		dataType: string
		lineageTag: 206887ac-816b-4ff8-a09c-cffafb55fcdc
		sourceColumn: Configuration

	column Sharing
		dataType: string
		lineageTag: 32bbd0e0-553e-4cbd-b71b-7ea9b641d483
		sourceColumn: Sharing

	column UsageSignal
		dataType: string
		lineageTag: 840a9baf-7e4d-4564-b9c2-7438f2d22d8f
		sourceColumn: UsageSignal

	column MessageVolume
		dataType: string
		lineageTag: 115fc876-b3d8-43e3-9ec0-0f23f1ed9ef7
		sourceColumn: MessageVolume

	column WhyNot
		dataType: string
		lineageTag: 4662d1aa-6c9a-49a1-8239-23d8d95fe9d3
		sourceColumn: WhyNot

	partition TelemetryCoverage = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SortOrder = Int64.Type, Platform = text, Inventory = text, Configuration = text, Sharing = text, UsageSignal = text, MessageVolume = text, WhyNot = text],
				        {
				            { 1, "Copilot Studio", "Full", "Full", "Full", "Yes - lastUsed + audit log", "Yes - per turn", "Copilot Studio agents are Dataverse-backed Power Platform resources, so they emit microsoft.powerplatformusage/usagerecords. Verified: 1,648 of 20,354 have ever produced one. Per-turn volume now also comes from Purview CopilotInteraction records, joined on the agent's schema name." },
				            { 2, "M365 Copilot Agent Builder", "Full", "Full", "Full", "Yes - Purview audit log", "Yes - per turn", "Declarative agents run inside the Microsoft 365 Copilot host, not the Power Platform runtime, so they emit no Power Platform usage records at all - 0 of 166 matched. Solved instead by reading CopilotInteraction records from the Purview unified audit log and joining AppIdentity (Copilot.Studio.Declarative.T_*) back to the agent's TitleId. This gives per-turn, per-user usage - better than the lastUsed timestamp Copilot Studio exposes." },
				            { 3, "Azure AI Foundry", "Projects only", "Partial", "N/A", "None", "No", "Resource Graph sees Foundry projects but not the agents inside them, and exposes no usage or activity timestamp for them at all - the Power Platform usage-record table only covers Power Platform resources. Verified: 0 of 93 Foundry projects carry any usage or last-activity property. Per-agent inventory and usage need the Foundry data-plane /assistants API on each project's own endpoint, plus Application Insights for invocation telemetry." },
				            { 4, "Agent flows", "Full", "Full", "N/A", "Yes - lastUsed timestamp", "No", "Agent flows are Power Automate resources and do emit usage records, but verified only 11 of 564 have ever produced one." }
				        }
				    )
				in
				    Source

