/// Live-tested API investigation results - what this solution can and cannot read without an Agent 365 licence.
table ApiCoverage
	lineageTag: 9f326d0c-7d83-4c3d-b7c3-a9ad51b4299a

	column SortOrder
		dataType: int64
		isHidden
		lineageTag: 1c182f74-e8ac-42f2-864c-9d56f4f97007
		sourceColumn: SortOrder

	column Source
		dataType: string
		lineageTag: 8cb3d04d-6188-45f1-bb0a-113a68f7c540
		sourceColumn: Source

	column Endpoint
		dataType: string
		lineageTag: db5f48a7-9c25-4117-9efb-e658dfd11384
		sourceColumn: Endpoint
		sortByColumn: SortOrder

	column Result
		dataType: string
		lineageTag: 2b590267-3e7e-423d-b4bf-c221334925f9
		sourceColumn: Result

	column Verdict
		dataType: string
		lineageTag: 6579d4aa-15a4-496a-824f-657be1ef2935
		sourceColumn: Verdict

	column WhatItGives
		dataType: string
		lineageTag: c9116766-6587-4917-8290-77412ccff72c
		sourceColumn: WhatItGives

	partition ApiCoverage = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SortOrder = Int64.Type, Source = text, Endpoint = text, Result = text, Verdict = text, WhatItGives = text],
				        {
				            { 1, "Azure Resource Graph", "PowerPlatformResources / microsoft.copilotstudio/agents", "Working", "Working", "Full agent inventory for Copilot Studio and Agent Builder, including topics, tools, knowledge, connectors, sharing, model and orchestration." },
				            { 2, "Azure Resource Graph", "PowerPlatformResources / microsoft.powerplatformusage/usagerecords", "Working", "Working", "Per-resource lastUsed signal. This is the adoption and activity backbone." },
				            { 3, "Azure Resource Graph", "PowerPlatformResources / microsoft.powerplatform/environments", "Working", "Working", "Environment names, types, regions and managed status." },
				            { 4, "Azure Resource Graph", "PowerPlatformResources / agentflows + m365agentflows", "Working", "Working", "Autonomous agent flows and Microsoft 365 agent flows." },
				            { 5, "Azure Resource Graph", "resources / cognitiveservices + machinelearningservices", "Working", "Working", "Azure AI Foundry accounts, hubs and projects." },
				            { 6, "Microsoft Graph", "/copilot/admin/catalog/packages", "Blocked (403)", "Needs Agent 365", "The Copilot agent registry. Officially requires a Microsoft Agent 365 licence, so it is unavailable here." },
				            { 7, "Microsoft Graph", "/beta/copilot/agents", "Not available (404)", "Needs Agent 365", "Endpoint does not exist in this tenant." },
				            { 8, "Microsoft Graph", "/appCatalogs/teamsApps", "Blocked (403)", "Needs consent", "Needs AppCatalog.Read.All, which the Azure CLI token cannot issue. Reachable with a dedicated app registration." },
				            { 9, "Microsoft Graph", "Copilot usage reports", "Blocked (403)", "Needs consent", "Needs Reports.Read.All. Would add per-user Copilot interaction volumes." },
				            { 10, "Microsoft Graph", "/v1.0/directoryObjects/getByIds", "Working", "Working", "Resolves agent creator and owner GUIDs to real display names and UPNs. Works with the plain Azure CLI token - no app registration needed." },
				            { 11, "Dataverse Web API", "botcomponents (componenttype 16)", "Working, used", "Working", "The named knowledge sources - the actual SharePoint site, public website, Graph connector or Azure AI Search index each agent reads. Verified as the ONLY place these names exist: an agent's Resource Graph properties expose 67 distinct leaf paths and not one holds a URL. Swept out of band because it means one Dataverse endpoint per environment - 742 here - which Power Query treats as a dynamic data source and the service will not refresh without a gateway. The sweep runs as an application user granted per environment, which also reaches the 92 environments that refuse an interactive admin." },
				            { 12, "Power Platform BAP / PPAPI", "environments", "Working, superseded", "Working", "Returned the same environment list. Resource Graph gives the same data in one call." },
				            { 13, "api.powerplatform.com", "resourcequery (inventory API)", "Failed (400)", "Failed", "Documented Power Platform inventory endpoint rejected every api-version tried; Resource Graph is the working equivalent." },
				            { 14, "Microsoft Graph", "/v1.0/security/auditLog/queries (app-only)", "Working", "Working", "Purview unified audit log. Returns every CopilotInteraction record in the tenant - per-turn usage for Agent Builder, Copilot Studio, base M365 Copilot and Microsoft's first-party agents. Needs the AuditLogsQuery.Read.All application role." },
				            { 15, "Exchange Online PowerShell", "Search-UnifiedAuditLog -RecordType CopilotInteraction", "Working", "Working", "The delegated equivalent of the Graph audit query. Works with an Exchange Administrator role and no app registration; connect with -DisableWAM in headless hosts." },
				            { 16, "Purview audit record", "CopilotEventData.AppIdentity", "Working", "Working", "The join key that makes per-agent usage possible: Copilot.Studio.Declarative.T_* maps to TitleId, Copilot.Studio.<env>-<schema> maps to SchemaName. CopilotEventData.AgentId and .AgentName are empty in this tenant and cannot be relied on." },
				            { 17, "Dataverse Web API", "bots (Agent Builder coverage)", "Not available", "Structural gap", "Agent Builder agents are not stored in Dataverse at all. Verified: 0 of 171 matched by schemaName and only 4 by display name, so no named knowledge source can ever be retrieved for them by this route. Their grounding is visible at type level only, from Resource Graph." },
				            { 18, "Microsoft Defender", "api.security.microsoft.com/api/advancedqueries", "Working from Power BI", "Working", "Advanced hunting - the Shadow AI lane. Reads DeviceTvmSoftwareInventory, DeviceProcessEvents and DeviceNetworkEvents to find unsanctioned AI tooling on managed devices. The Web connector signs in with an organizational account, so the token is issued for the signed-in user and the lane works for anyone holding Security Reader - proven by live refreshes returning real device rows. A script token is a different matter: the Azure CLI first-party app carries no AdvancedQuery.Read consent and is refused with 403, so this lane cannot be driven from a script without its own app registration. In the service, tick Skip test connection when setting the credential - Power BI validates a Web source by fetching its registered host and advanced hunting returns 404 at the root. Wired up in FnHunt, which fails soft to an empty table so a refusal here cannot block the rest of the model." },
				            { 19, "Microsoft Defender", "DeviceTvmSoftwareInventory (licensing)", "Working - licensed and onboarded here", "Working", "The installed-software layer comes from Defender Vulnerability Management, so it needs Defender for Endpoint P2 or the standalone MDVM add-on. Both are present in this tenant and the layer returns live rows. The limit that remains is coverage, not licensing: only devices actually onboarded to Defender are visible, so unmanaged and BYOD devices are invisible to all three Shadow AI layers - precisely where shadow AI is most likely to live. Read the page as a floor, not a census. A tenant without Defender for Endpoint loses this layer only; the executed and network layers degrade independently and FnHunt returns an empty table rather than failing the refresh." },
				            { 20, "Microsoft Defender", "DeviceTvmSoftwareInventory (matching)", "Working, corrected", "Working", "Software inventory returns package-registry entries, not just installed applications. The first live refresh reported the Cursor editor on a build agent; the real rows were the npm packages node-cli-cursor and restore-cursor. KQL has_any is token-based, so 'cursor' matches inside 'node-cli-cursor'. The installed layer now asks the server for a name PREFIX and FnInstalledMatch refuses to map a row whose name does not lead with a watched term unless its vendor matches, which keeps 'Anysphere Cursor' while dropping the packages. The executed layer was never affected - it matches FileName with in~, which is exact." },
				            { 21, "Azure Resource Graph", "PowerPlatformResources / createdIn (inventory completeness)", "Working, verified", "Working", "Audited on 4 September 2026 to confirm the agent inventory really is tenant-wide. Three checks: only 1 of the 12 PowerPlatformResources types holds agents; createdIn returns exactly two values that sum to the total with nothing left over (20,499 Copilot Studio + 171 Copilot Studio Lite = 20,670, no blanks and no third authoring surface); and the lane is scoped by Power Platform Administrator rather than Azure RBAC, so there is no per-subscription blind spot. Agent Builder carries a titleId on exactly the 100 agents that are published, because the identifier is minted at publish - the 71 unpublished drafts therefore have no join key to the audit log, which is correct rather than a broken join. One caveat: paging this export with $skipToken is only stable when the query orders by a UNIQUE column. Ordering by titleId, which is empty on most rows, returned the right total but a wrong split of 20,512/158; ordering by id returned the correct 20,499/171." },
				            { 22, "Azure AI Foundry data plane", "<project>.services.ai.azure.com/api/projects/*/assistants", "Blocked (401) on 11 of 12 projects", "Needs data-plane role", "The only endpoint that can count Foundry AGENTS. Resource Graph returns one row per project, so the 94 Foundry rows in the Agent table are projects, not agents, and Agent Count therefore mixes two units. Measured, not assumed: the one project that did authorise returned 3 agents where the inventory counts 1. Enumerating the rest needs an Azure AI data-plane role on every project, which a tenant-wide inventory identity is unlikely to hold. Foundry is also the one lane governed by Azure RBAC rather than an Entra role, so ARG returns only the subscriptions the refresh identity can read - 7 here - and missing subscriptions are absent silently rather than erroring." },
				            { 23, "Purview audit record", "CopilotEventData.AppIdentity (SPO_ prefix)", "Working, used", "Working", "How SharePoint usage joins to inventory. FnSpo decodes the site, web and list GUIDs, then base32-decodes the final drive-item segment and converts its payload to ListItemUniqueId. That GUID joins exactly to SharePointAgent, so used agents inherit their real file name, site and URL while retaining per-turn and per-user usage." },
				            { 24, "Microsoft Graph Purview audit query", "/v1.0/security/auditLog/queries (sharePointFileOperation, keyword .agent)", "Working, used", "Working", "The SharePointAgentLogging inventory lane. A 180-day live query returned 4,991 file-operation records, including 723 .agent events over 64 stable ListItemUniqueId values; latest state was 61 current and 3 deleted or recycled. It uses the same AuditLogsQuery.Read.All application role as interaction telemetry and needs no Sites.Read.All. The limit is audit retention: a .agent file with no operation inside the lookback window is not observable." }
				        }
				    )
				in
				    Source
