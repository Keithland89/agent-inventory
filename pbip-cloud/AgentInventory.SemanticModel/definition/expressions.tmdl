		    Rows = Table.SelectRows(SharePointAgent, each [AgentKey] <> null and [AgentKey] <> ""),
		    Kept = Table.SelectColumns(Rows, {"AgentKey", "AgentName", "SiteUrl", "ObjectUrl", "IsDeleted"}),
		    Keyed = Table.TransformColumns(Kept, {{"AgentKey", each Text.Lower(Text.Trim(_)), type text}})
		in
		    Table.Distinct(Keyed, {"AgentKey"})
