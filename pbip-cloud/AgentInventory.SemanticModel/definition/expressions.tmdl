	annotation PBI_ResultType = Function

expression FnRetry =
		(producer as function, seed as number) as any =>
		let
		    Once = () => try producer(),
		    Jitter = Number.Mod(seed, 5),
		    Tries = List.Generate(
		        () => [n = 0, r = Once(), go = true],
		        each _[go],
		        each if not _[r][HasError] or _[n] >= 5
		             then [n = _[n], r = _[r], go = false]
		             else [n = _[n] + 1, r = Function.InvokeAfter(Once, #duration(0, 0, 0, Number.Power(2, _[n]) + Jitter)), go = true],
		        each _[r]),
		    Last = List.Last(Tries),
		    // The last attempt is deliberately not wrapped in `try`, so a genuine failure
		    // surfaces with its own message rather than one invented by this loop.
		    Result = if Last = null or Last[HasError] then producer() else Last[Value]
		in
		    Result
	lineageTag: 181178bc-cbb2-449f-86a3-191c5e765b94

