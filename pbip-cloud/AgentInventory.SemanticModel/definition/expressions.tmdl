	annotation PBI_ResultType = Function

expression FnArg =
		(query as text) as list =>
		let
		    // Table.Buffer forces the connector to page through every result inside FnRetry's
		    // `try`. Without it the query is lazy, the transport failure surfaces later during
		    // Table.ToRecords below, and the retry never sees an error to act on.
		    Fetch = () => Table.Buffer(AzureResourceGraph.Query(query, "Tenant", null, null, [resultTruncated = false])),
		    Raw = FnRetry(Fetch, Text.Length(query)),
		    // A query that matches nothing returns #table({"Results"}, {{"No results"}}),
		    // which shares no columns with the projection, so normalise it to an empty list.
		    NoRows = Table.ColumnCount(Raw) = 1 and List.Contains(Table.ColumnNames(Raw), "Results"),
		    Rows = if NoRows then {} else Table.ToRecords(Raw)
		in
		    Rows
	lineageTag: df5714ef-d608-41bb-8c89-2d5e6ef77757

	annotation PBI_ResultType = Function

/// Every AI tool this solution looks for on Defender-managed devices. Single source of truth:
/// the hunting queries and the ShadowAiCatalog table are all generated from this one list, so
/// adding a tool means editing here and nowhere else.
/// Posture is the only judgement call in the table - sanctioned-or-not is local policy, not
/// something any API reports. Edit it to match your own approved-tooling list.
/// VendorMatch is blank for Microsoft, Google, GitHub and Hugging Face on purpose: matching those
/// vendor names against software inventory would return every Edge and Chrome install in the estate.
expression ShadowAiWatchlist =
		#table(
		    type table [Category = text, Vendor = text, AppName = text, Posture = text, SoftwareMatch = text, VendorMatch = text, ProcessName = text, Domain = text],
		    {
		        { "Assistant", "Anthropic", "Claude Code", "Unsanctioned", "claude code", "", "claude.exe", "" },
		        { "Assistant", "OpenAI", "ChatGPT", "Unsanctioned", "chatgpt", "openai", "chatgpt.exe", "chatgpt.com" },
		        { "Assistant", "Anthropic", "Claude", "Unsanctioned", "claude", "anthropic", "", "claude.ai" },
		        { "Assistant", "Google", "Gemini", "Unsanctioned", "", "", "", "gemini.google.com" },
		        { "Assistant", "Perplexity", "Perplexity", "Unsanctioned", "perplexity", "perplexity", "perplexity.exe", "perplexity.ai" },
		        { "Assistant", "xAI", "Grok", "Unsanctioned", "", "", "", "grok.com" },
		        { "Assistant", "DeepSeek", "DeepSeek", "Unsanctioned", "", "", "", "deepseek.com" },
		        { "Assistant", "Mistral AI", "Le Chat", "Unsanctioned", "", "", "", "chat.mistral.ai" },
		        { "Assistant", "Microsoft", "Microsoft Copilot", "Sanctioned", "microsoft copilot", "", "", "copilot.microsoft.com" },
		        { "Coding", "GitHub", "GitHub Copilot", "Sanctioned", "github copilot", "", "copilot.exe", "api.githubcopilot.com" },
		        { "Coding", "Anysphere", "Cursor", "Unsanctioned", "cursor", "anysphere", "cursor.exe", "cursor.com" },
		        { "Coding", "Codeium", "Windsurf", "Unsanctioned", "windsurf", "codeium", "windsurf.exe", "codeium.com" },
		        { "Coding", "Tabnine", "Tabnine", "Unsanctioned", "tabnine", "tabnine", "tabnine.exe", "tabnine.com" },
		        { "Local model", "Ollama", "Ollama", "Unsanctioned", "ollama", "ollama", "ollama.exe", "ollama.com" },
		        { "Local model", "LM Studio", "LM Studio", "Unsanctioned", "lm studio", "lm studio", "lm studio.exe", "lmstudio.ai" },
		        { "Local model", "Nomic AI", "GPT4All", "Unsanctioned", "gpt4all", "nomic", "gpt4all.exe", "gpt4all.io" },
		        { "Local model", "Msty", "Msty", "Unsanctioned", "msty", "msty", "msty.exe", "msty.app" },
		        { "Local model", "Mintplex Labs", "AnythingLLM", "Unsanctioned", "anythingllm", "mintplex", "anythingllm.exe", "anythingllm.com" },
		        { "API endpoint", "OpenAI", "OpenAI API", "Unsanctioned", "", "", "", "api.openai.com" },
		        { "API endpoint", "Anthropic", "Anthropic API", "Unsanctioned", "", "", "", "api.anthropic.com" },
		        { "API endpoint", "Google", "Gemini API", "Unsanctioned", "", "", "", "generativelanguage.googleapis.com" },
		        { "API endpoint", "Hugging Face", "Hugging Face", "Unsanctioned", "", "", "", "huggingface.co" }
		    })
	lineageTag: 75508144-4ed9-4e90-9cfc-89d844d2c8c2

	annotation PBI_ResultType = Table

/// One column of ShadowAiWatchlist as a quoted, comma-separated KQL term list. Blank entries are
/// dropped, so a tool with no process name contributes nothing to the process query.
expression FnWatchTerms =
		(column as text) as text =>
		let
		    Vals = List.Select(Table.Column(ShadowAiWatchlist, column), each _ <> null and Text.Trim(_) <> ""),
		    Quoted = List.Transform(List.Distinct(Vals), each "'" & Text.Lower(Text.Trim(_)) & "'")
		in
		    Text.Combine(Quoted, ", ")
	lineageTag: 3a91880b-816f-4dd6-a677-fd191b77cac2

	annotation PBI_ResultType = Function

/// The watchlist row whose term for `column` appears in `value`, or null. Longest term wins, so
/// "Claude Code" resolves to its own row rather than the shorter "claude" one regardless of row order.
expression FnWatchMatch =
		(value as nullable text, column as text) as nullable record =>
		let
		    V = Text.Lower(if value = null then "" else value),
		    Candidates = Table.SelectRows(ShadowAiWatchlist, each Text.Trim(Record.Field(_, column)) <> ""),
		    Ranked = Table.AddColumn(Candidates, "TermLen", each Text.Length(Record.Field(_, column)), Int64.Type),
		    Sorted = Table.Sort(Ranked, {{"TermLen", Order.Descending}}),
		    Hits = Table.SelectRows(Sorted, each Text.Contains(V, Text.Lower(Text.Trim(Record.Field(_, column))))),
		    First = if Table.IsEmpty(Hits) then null else Hits{0}
		in
		    First
	lineageTag: be68be2a-45cc-454d-9fa1-87eab6e4cd40

	annotation PBI_ResultType = Function

/// Runs one Microsoft Defender advanced hunting query and returns its rows.
/// Two deliberate choices here:
/// 1. The base URL is a literal and everything variable goes in RelativePath and Query. That keeps this
/// a STATIC data source, which is what lets scheduled refresh run in the service with no gateway.
/// Concatenating the KQL into the URL would make it dynamic and the service would refuse it.
/// To use a regional host - uk. eu. us. au. - edit the literal below; do not make it a parameter.
/// 2. A failure returns an empty table rather than propagating. Defender may be unlicensed, have no
/// onboarded devices, or refuse the account for want of AdvancedQuery.Read; none of that should stop
/// the other sixteen tables refreshing. Same contract as FnDataverseOptional.
expression FnHunt =
		(query as text, columns as list) as table =>
		let
		    Fetch = () =>
		        let
		            Raw = Web.Contents(
		                      "https://api.security.microsoft.com",
		                      [RelativePath = "api/advancedqueries", Query = [key = query], Timeout = #duration(0, 0, 4, 0)]),
		            Parsed = Json.Document(Raw),
		            Items = if Record.HasFields(Parsed, "Results") then Parsed[Results] else {},
		            Tbl = FnRecordsToTable(Items, columns)
		        in
		            Table.Buffer(Tbl),
		    Attempt = try FnRetry(Fetch, Text.Length(query))
		in
		    if Attempt[HasError] then #table(columns, {}) else Attempt[Value]
	lineageTag: 156771b8-ae21-42eb-82c6-cdb72c9040d3

	annotation PBI_ResultType = Function

/// Layer 1 - AI tools INSTALLED on managed devices, from Defender Vulnerability Management's software
/// inventory. Catches packaged desktop apps. Misses portable binaries and anything run from a CLI.
/// Matched on a name PREFIX, not a contains: package registries inventory things like
/// "node-cli-cursor" and a contains-match reports them as the Cursor editor.
expression SrcShadowInstalled =
		let
		    Kql = "DeviceTvmSoftwareInventory"
		        & " | where (" & FnWatchPrefix("SoftwareMatch", "SoftwareName") & ")"
		        & " or SoftwareVendor has_any (" & FnWatchTerms("VendorMatch") & ")"
		        & " | summarize DeviceCount = dcount(DeviceId) by SoftwareName, SoftwareVendor"
		        & " | top 200 by DeviceCount desc",
		    Rows = FnHunt(Kql, {"SoftwareName", "SoftwareVendor", "DeviceCount"}),
		    Kept = List.Select(Table.ToRecords(Rows), each FnInstalledMatch([SoftwareName], [SoftwareVendor]) <> null),
		    Recs = List.Transform(Kept, (r) =>
		               let
		                   W = FnInstalledMatch(r[SoftwareName], r[SoftwareVendor])
		               in
		                   [ Layer = "Installed",
		                     Category = W[Category],
		                     Vendor = W[Vendor],
		                     AppName = W[AppName],
		                     Posture = W[Posture],
		                     Detected = r[SoftwareName],
		                     DeviceCount = r[DeviceCount],
		                     UserCount = null,
		                     LastSeen = null ]),
		    Out = FnRecordsToTable(Recs, {"Layer", "Category", "Vendor", "AppName", "Posture", "Detected", "DeviceCount", "UserCount", "LastSeen"})
		in
		    Out
	lineageTag: bab61974-1a85-45bb-a217-75f223efe302

	annotation PBI_ResultType = Table

/// Layer 2 - AI tools actually EXECUTED in the last 30 days, from process telemetry. This is the layer
/// that catches CLI tooling such as Claude Code and GitHub Copilot CLI, which never appears in software
/// inventory because it is installed per user without an installer.
/// Matched with in~ rather than has_any: FileName holds exactly the file name, so an exact
/// case-insensitive list match is both precise and indexed.
expression SrcShadowExecuted =
		let
		    Kql = "DeviceProcessEvents"
		        & " | where Timestamp > ago(30d)"
		        & " | where FileName in~ (" & FnWatchTerms("ProcessName") & ")"
		        & " | summarize DeviceCount = dcount(DeviceId), UserCount = dcount(AccountUpn), LastSeen = max(Timestamp) by FileName, ProcessVersionInfoCompanyName"
		        & " | top 200 by DeviceCount desc",
		    Rows = FnHunt(Kql, {"FileName", "ProcessVersionInfoCompanyName", "DeviceCount", "UserCount", "LastSeen"}),
		    Recs = List.Transform(Table.ToRecords(Rows), (r) =>
		               let
		                   W = FnWatchMatch(r[FileName], "ProcessName")
		               in
		                   [ Layer = "Executed",
		                     Category = if W = null then "Unclassified" else W[Category],
		                     Vendor = if W = null then r[ProcessVersionInfoCompanyName] else W[Vendor],
		                     AppName = if W = null then r[FileName] else W[AppName],
		                     Posture = if W = null then "Unsanctioned" else W[Posture],
		                     Detected = r[FileName],
		                     DeviceCount = r[DeviceCount],
		                     UserCount = r[UserCount],
		                     LastSeen = FnToDateTime(r[LastSeen]) ]),
		    Out = FnRecordsToTable(Recs, {"Layer", "Category", "Vendor", "AppName", "Posture", "Detected", "DeviceCount", "UserCount", "LastSeen"})
		in
		    Out
	lineageTag: dc6cb6da-79e3-4042-8d3e-5629854df583

	annotation PBI_ResultType = Table

/// Layer 3 - devices TALKING to AI service endpoints in the last 30 days. Catches browser and script
/// use where nothing is installed and no recognisable process runs, which is the majority of shadow AI.
expression SrcShadowNetwork =
		let
		    Kql = "DeviceNetworkEvents"
		        & " | where Timestamp > ago(30d)"
		        & " | where isnotempty(RemoteUrl)"
		        & " | where RemoteUrl has_any (" & FnWatchTerms("Domain") & ")"
		        & " | summarize DeviceCount = dcount(DeviceId), UserCount = dcount(InitiatingProcessAccountUpn), LastSeen = max(Timestamp) by RemoteUrl"
		        & " | top 200 by DeviceCount desc",
		    Rows = FnHunt(Kql, {"RemoteUrl", "DeviceCount", "UserCount", "LastSeen"}),
		    Recs = List.Transform(Table.ToRecords(Rows), (r) =>
		               let
		                   W = FnWatchMatch(r[RemoteUrl], "Domain")
		               in
		                   [ Layer = "Network",
		                     Category = if W = null then "Unclassified" else W[Category],
		                     Vendor = if W = null then "" else W[Vendor],
		                     AppName = if W = null then r[RemoteUrl] else W[AppName],
		                     Posture = if W = null then "Unsanctioned" else W[Posture],
		                     Detected = r[RemoteUrl],
		                     DeviceCount = r[DeviceCount],
		                     UserCount = r[UserCount],
		                     LastSeen = FnToDateTime(r[LastSeen]) ]),
		    Out = FnRecordsToTable(Recs, {"Layer", "Category", "Vendor", "AppName", "Posture", "Detected", "DeviceCount", "UserCount", "LastSeen"})
		in
		    Out
	lineageTag: 3da415ab-5ff3-4739-89d0-e80d98f662e2

	annotation PBI_ResultType = Table

/// Device-grain detail behind ShadowAiSignal: which machines, and for executed tools which user and when.
/// Capped at 5,000 rows per layer - this is a drill-down, not an export.
expression SrcShadowDevice =
		let
		    KqlInstalled = "DeviceTvmSoftwareInventory"
		        & " | where (" & FnWatchPrefix("SoftwareMatch", "SoftwareName") & ")"
		        & " or SoftwareVendor has_any (" & FnWatchTerms("VendorMatch") & ")"
		        & " | project DeviceName, Detected = SoftwareName, Vendor = SoftwareVendor, Detail = SoftwareVersion"
		        & " | take 5000",
		    Installed = FnHunt(KqlInstalled, {"DeviceName", "Detected", "Vendor", "Detail"}),
		    InstalledKept = List.Select(Table.ToRecords(Installed), each FnInstalledMatch([Detected], [Vendor]) <> null),
		    InstalledRecs = List.Transform(InstalledKept, (r) =>
		               let
		                   W = FnInstalledMatch(r[Detected], r[Vendor])
		               in
		                   [ Layer = "Installed",
		                     DeviceName = r[DeviceName],
		                     AppName = W[AppName],
		                     Posture = W[Posture],
		                     Detected = r[Detected],
		                     Detail = r[Detail],
		                     UserUpn = null,
		                     LastSeen = null ]),
		    KqlRun = "DeviceProcessEvents"
		        & " | where Timestamp > ago(30d)"
		        & " | where FileName in~ (" & FnWatchTerms("ProcessName") & ")"
		        & " | summarize LastSeen = max(Timestamp), Runs = count() by DeviceName, FileName, AccountUpn"
		        & " | top 5000 by LastSeen desc",
		    Run = FnHunt(KqlRun, {"DeviceName", "FileName", "AccountUpn", "LastSeen", "Runs"}),
		    RunRecs = List.Transform(Table.ToRecords(Run), (r) =>
		               let
		                   W = FnWatchMatch(r[FileName], "ProcessName")
		               in
		                   [ Layer = "Executed",
		                     DeviceName = r[DeviceName],
		                     AppName = if W = null then r[FileName] else W[AppName],
		                     Posture = if W = null then "Unsanctioned" else W[Posture],
		                     Detected = r[FileName],
		                     Detail = if r[Runs] = null then "" else Text.From(r[Runs]) & " runs",
		                     UserUpn = r[AccountUpn],
		                     LastSeen = FnToDateTime(r[LastSeen]) ]),
		    Cols = {"Layer", "DeviceName", "AppName", "Posture", "Detected", "Detail", "UserUpn", "LastSeen"},
		    Out = Table.Combine({FnRecordsToTable(InstalledRecs, Cols), FnRecordsToTable(RunRecs, Cols)})
		in
		    Out
	lineageTag: 01c3a691-b139-48aa-9e13-afc0ca0fa939

	annotation PBI_ResultType = Table

/// A KQL prefix test per watched term - "SoftwareName startswith 'cursor' or ...".
/// Used instead of has_any for software inventory because has is token-based: "cursor" is a
/// token of "node-cli-cursor", so has_any reported an npm terminal-cursor package as the
/// Cursor editor. A prefix test cannot do that, and it keeps the precision on the server so
/// the top-N cap is spent on real hits rather than noise.
expression FnWatchPrefix =
		(column as text, field as text) as text =>
		let
		    Vals = List.Select(Table.Column(ShadowAiWatchlist, column), each _ <> null and Text.Trim(_) <> ""),
		    Tests = List.Transform(List.Distinct(Vals), each field & " startswith '" & Text.Lower(Text.Trim(_)) & "'")
		in
		    Text.Combine(Tests, " or ")
	lineageTag: 5f2c9a74-3e18-4d6b-9a11-7c4e0b2d8f36

	annotation PBI_ResultType = Function

/// The watchlist row for one software-inventory entry, or null if it is not a watched tool.
/// Deliberately stricter than FnWatchMatch: the name must START with the term. Contains-matching
/// mapped the npm packages "node-cli-cursor" and "restore-cursor" onto Cursor and reported a
/// build agent as running an unsanctioned AI editor. A vendor match is still accepted on its own,
/// so "Anysphere Cursor" is caught by its vendor even though the name does not lead with the term.
expression FnInstalledMatch =
		(name as nullable text, vendor as nullable text) as nullable record =>
		let
		    N = Text.Lower(if name = null then "" else Text.Trim(name)),
		    Candidates = Table.SelectRows(ShadowAiWatchlist, each Text.Trim([SoftwareMatch]) <> ""),
		    Ranked = Table.AddColumn(Candidates, "TermLen", each Text.Length([SoftwareMatch]), Int64.Type),
		    Sorted = Table.Sort(Ranked, {{"TermLen", Order.Descending}}),
		    ByName = Table.SelectRows(Sorted, each Text.StartsWith(N, Text.Lower(Text.Trim([SoftwareMatch])))),
		    ByVendor = FnWatchMatch(vendor, "VendorMatch")
		in
		    if not Table.IsEmpty(ByName) then ByName{0} else ByVendor
	lineageTag: 8d3b1c60-6a92-4f57-b8e3-15d9c7a4e2b0

	annotation PBI_ResultType = Function
