expression FnLooksGuid =
		(s as text) as logical =>
		    Text.Length(s) >= 36
		    and Text.Middle(s, 8, 1) = "-" and Text.Middle(s, 13, 1) = "-"
		    and Text.Middle(s, 18, 1) = "-" and Text.Middle(s, 23, 1) = "-"
		    and FnHexRun(Text.Start(s, 36))
	lineageTag: 4f536970-2a3c-47da-87c6-6a426fe899d8

	annotation PBI_ResultType = Function

expression FnSpo =
		// A SharePoint agent is a .agent file in a document library, and the audit log identifies it
		// as SPO_<base64url of "siteId,webId,listId">_<drive item id>. SharePointAgentLogging lands
		// ListItemUniqueId as the inventory key, so the final segment must be base32-decoded to the
		// same GUID. It uses A-Z2-7 and never contains an underscore, so splitting on the LAST
		// underscore is safe even though base64url uses one.
		(appIdentity as nullable text) as record =>
		let
		    a = if appIdentity = null then "" else Text.Trim(appIdentity),
		    DecodeItemGuid = (driveItemId as text) as text =>
		        let
		            Encoded = if Text.StartsWith(driveItemId, "01") then Text.Range(driveItemId, 2) else driveItemId,
		            Alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZ234567",
		            Values = List.Transform(Text.ToList(Text.Upper(Encoded)), each Text.PositionOf(Alphabet, _)),
		            Valid = Text.Length(Encoded) = 32 and List.AllTrue(List.Transform(Values, each _ >= 0)),
		            Bits = if not Valid then {} else List.Combine(List.Transform(Values, (v) =>
		                List.Transform({4, 3, 2, 1, 0}, (power) => Number.Mod(Number.IntegerDivide(v, Number.Power(2, power)), 2)))),
		            Bytes = if not Valid then {} else List.Transform(List.Split(Bits, 8), (octet) =>
		                List.Sum(List.Transform(List.Positions(octet), (i) => octet{i} * Number.Power(2, 7 - i)))),
		            GuidBytes = if List.Count(Bytes) = 20 then List.Range(Bytes, 4, 16) else {},
		            Hex = (n as number) as text =>
		                Text.Range("0123456789abcdef", Number.IntegerDivide(n, 16), 1)
		                & Text.Range("0123456789abcdef", Number.Mod(n, 16), 1),
		            JoinHex = (items as list) as text => Text.Combine(List.Transform(items, each Hex(_))),
		            Value =
		                if List.Count(GuidBytes) <> 16 then ""
		                else JoinHex(List.Reverse(List.FirstN(GuidBytes, 4))) & "-"
		                    & JoinHex(List.Reverse(List.Range(GuidBytes, 4, 2))) & "-"
		                    & JoinHex(List.Reverse(List.Range(GuidBytes, 6, 2))) & "-"
		                    & JoinHex(List.Range(GuidBytes, 8, 2)) & "-"
		                    & JoinHex(List.Range(GuidBytes, 10, 6))
		        in
		            Value,
		    Empty = [SiteId = "", WebId = "", ListId = "", ItemId = "", ItemGuid = "", Ok = false],
		    r =
		        if not Text.StartsWith(a, "SPO_") then Empty
		        else
		            let
		                body = Text.Range(a, 4),
		                cut  = Text.PositionOf(body, "_", Occurrence.Last),
		                blob = if cut > 0 then Text.Start(body, cut) else "",
		                item = if cut > 0 then Text.Range(body, cut + 1) else body,
		                std  = Text.Replace(Text.Replace(blob, "-", "+"), "_", "/"),
		                pad  = std & Text.Repeat("=", Number.Mod(4 - Number.Mod(Text.Length(std), 4), 4)),
		                dec  = try Text.FromBinary(Binary.FromText(pad, BinaryEncoding.Base64), TextEncoding.Utf8) otherwise "",
		                ids  = Text.Split(dec, ","),
		                itemGuid = DecodeItemGuid(item)
		            in
		                // A malformed site blob still leaves the item GUID usable, so the site fields
		                // degrade to empty rather than losing an otherwise exact inventory join.
		                if List.Count(ids) = 3 and Text.Length(dec) > 0
		                then [SiteId = ids{0}, WebId = ids{1}, ListId = ids{2}, ItemId = item, ItemGuid = itemGuid, Ok = itemGuid <> ""]
		                else [SiteId = "", WebId = "", ListId = "", ItemId = item, ItemGuid = itemGuid, Ok = itemGuid <> ""]
		in
		    r
	lineageTag: 3a0f7c41-92d6-4ee8-b5a1-7c4e0d81f6b2

	annotation PBI_ResultType = Function

expression FnSurface =
		(appIdentity as nullable text) as record =>
		let
		    a = if appIdentity = null then "" else Text.Trim(appIdentity),
		    Mk = (t as text, p as text, k as text, o as text, n as text, ag as logical) as record =>
		        [SurfaceType = t, Platform = p, MatchKey = k, MatchOn = o, DisplayName = n, IsAgent = ag],
		
		    // Copilot Studio agent in the default environment: org id then '-' then schema name.
		    csDefault =
		        let
		            rest = Text.Range(a, 23),
		            hit  = List.Select({32, 33, 34, 35, 36}, each
		                       Text.Length(rest) > _ + 1
		                       and Text.Middle(rest, _, 1) = "-"
		                       and FnHexRun(Text.Start(rest, _)))
		        in
		            if List.IsEmpty(hit) then null
		            else Mk("Copilot Studio agent", "Copilot Studio", Text.Range(rest, List.First(hit) + 1), "SchemaName", a, true),
		
		    // Copilot Studio agent in a named environment: a 36 character GUID then '-' then schema name.
		    csNamed =
		        let rest = Text.Range(a, 15) in
		        if FnLooksGuid(rest) and Text.Middle(rest, 36, 1) = "-" and Text.Length(rest) > 37
		        then Mk("Copilot Studio agent", "Copilot Studio", Text.Range(rest, 37), "SchemaName", a, true)
		        else null,
		
		    // Microsoft first party agents: MicrosoftAgent.<name>.<BuiltIn_*|P_*>
		    ms1p =
		        let
		            rest  = Text.Range(a, 15),
		            cands = List.Select({Text.PositionOf(rest, ".BuiltIn_"), Text.PositionOf(rest, ".P_")}, each _ > 0)
		        in
		            if List.IsEmpty(cands) then null
		            else Mk("Microsoft 1P agent", "M365 Copilot", "", "", Text.Start(rest, List.Min(cands)), false),
		
		    r =
		        if a = "" then
		            Mk("M365 Copilot (base)", "M365 Copilot", "", "", "M365 Copilot - no app identity", false)
		        else if Text.StartsWith(a, "Copilot.Studio.Declarative.T_") then
		            Mk("Agent Builder agent", "M365 Copilot", Text.Range(a, 27), "TitleId", a, true)
		        else if Text.StartsWith(a, "TeamsToolkit.Declarative.T_") then
		            Mk("Teams Toolkit agent", "M365 Copilot", Text.Range(a, 25), "TitleId", "Teams Toolkit agent " & Text.Middle(a, 27, 8), true)
		        else if Text.StartsWith(a, "U_") then
		            Mk("Personal agent", "M365 Copilot", a, "TitleId", "Personal agent " & Text.Middle(a, 2, 8), true)
		        // SharePoint agents carry no TitleId or SchemaName because they are files, not Power
		        // Platform resources. CopilotSurface joins them separately to SharePointAgent on the
		        // decoded ListItemUniqueId.
		        else if Text.StartsWith(a, "SPO_") then
		            let sid = FnSpo(a)[ItemId] in
		            Mk("SharePoint agent", "SharePoint", "", "", "SharePoint agent " & (if Text.Length(sid) <= 6 then sid else Text.End(sid, 6)), true)
		        else if Text.StartsWith(a, "Copilot.Studio.CustomEngine.T_") then
		            Mk("Custom engine agent", "M365 Copilot", Text.Range(a, 28), "TitleId", a, true)
		        else if Text.StartsWith(a, "Copilot.Studio.Default-") and csDefault <> null then csDefault
		        else if Text.StartsWith(a, "Copilot.Studio.") and csNamed <> null then csNamed
		        else if Text.StartsWith(a, "T_") then
		            Mk("Declarative agent", "M365 Copilot", a, "TitleId", a, true)
		        else if Text.StartsWith(a, "MicrosoftAgent.AgentBuilder") or a = "AgentBuilder" then
		            Mk("Agent Builder authoring", "M365 Copilot", "", "", "Agent Builder (authoring)", false)
		        else if Text.StartsWith(a, "MicrosoftAgent.") and ms1p <> null then ms1p
		        else if Text.StartsWith(a, "Copilot.M365Copilot.") then
		            Mk("M365 Copilot (base)", "M365 Copilot", "", "", "M365 Copilot - " & Text.Range(a, 20), false)
		        else if Text.StartsWith(a, "Copilot.Fabric.") then
		            Mk("Fabric / Power BI copilot", "Fabric", "", "", Text.Range(a, 15), false)
		        else if Text.StartsWith(a, "Copilot.") and Text.Contains(a, "PowerBI") then
		            Mk("Fabric / Power BI copilot", "Power BI", "", "", Text.Range(a, 8), false)
		        else if Text.StartsWith(a, "Copilot.Studio.") then
		            Mk("Copilot Studio (other)", "Copilot Studio", "", "", a, false)
		        else if Text.StartsWith(a, "Copilot.") then
		            Mk("Other Microsoft copilot", "Microsoft 365", "", "", a, false)
		        else
		            Mk("Unknown", "Unknown", "", "", a, false)
		in
		    r
	lineageTag: eb0c03bb-e14c-42a7-bf27-4d0e020af5f3

