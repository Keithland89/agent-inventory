expression FnToDateTime =
		(v as any) as nullable datetime =>
		    if v = null or v = "" then null
		    else try DateTime.From(DateTimeZone.RemoveZone(DateTimeZone.From(v))) otherwise (try DateTime.From(v) otherwise null)
	lineageTag: e6d13d2a-354a-4976-9aad-76446abd8a0e

