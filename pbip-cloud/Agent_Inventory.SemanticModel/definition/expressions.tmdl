expression FnRecordsToTable =
		(items as list, columns as list) as table =>
		    if List.IsEmpty(items) then #table(columns, {})
		    else Table.SelectColumns(Table.FromRecords(items), columns, MissingField.UseNull)
	lineageTag: 89467463-c4ec-4949-bb79-981ca1afb84d

	annotation PBI_ResultType = Function

expression FnRetry =
		(producer as function, seed as number) as any =>
		let
		    Once = () => try producer(),
		    Jitter = Number.Mod(seed, 5),
		    Tries = List.Generate(
		        () => [n = 0, r = Once(), go = true],
		        each _[go],
		        each if not _[r][HasError] or _[n] >= 5
		             then [n = _[n], r = _[r], go = false]
		             else [n = _[n] + 1, r = Function.InvokeAfter(Once, #duration(0, 0, 0, Number.Power(2, _[n]) + Jitter)), go = true],
		        each _[r]),
		    Last = List.Last(Tries),
		    // The last attempt is deliberately not wrapped in `try`, so a genuine failure
		    // surfaces with its own message rather than one invented by this loop.
		    Result = if Last = null or Last[HasError] then producer() else Last[Value]
		in
		    Result
	lineageTag: aa4b2575-c4ca-4cf1-980d-1a4c93e70078

	annotation PBI_ResultType = Function

expression FnDataverse =
		(entitySet as text, columns as list) as table =>
		let
		    Fetch = () =>
		        let
		            Feed = OData.Feed(DataverseUrl & "/api/data/v9.2", null, [Implementation = "2.0", ODataVersion = 4]),
		            Tbl  = Feed{[Name = entitySet]}[Data],
		            Kept = Table.SelectColumns(Tbl, columns, MissingField.UseNull)
		        in
		            Table.Buffer(Kept)
		in
		    FnRetry(Fetch, Text.Length(entitySet))
	lineageTag: 4fd6c485-6820-4469-b16a-fc5152096871

	annotation PBI_ResultType = Function

