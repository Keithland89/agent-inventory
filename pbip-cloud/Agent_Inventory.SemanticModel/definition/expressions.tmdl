expression FnToLogical =
		(v as any) as nullable logical =>
		    if v = null or v = "" then null
		    else if v = true or v = 1 or v = "1" then true
		    else if v = false or v = 0 or v = "0" then false
		    else (try Logical.From(Text.Lower(Text.From(v))) otherwise null)
	lineageTag: 389a5435-9a8d-443b-8772-5ecbce17bff9

