/// What a Microsoft Agent 365 licence would add on top of this solution, and how to close each gap without one.
table AgentGap
	lineageTag: b34e4709-7ac1-4ba8-802a-8494220b9be7

	column SortOrder
		dataType: int64
		isHidden
		lineageTag: 8aae674e-e8e2-4b6c-ba65-d7547989e541
		sourceColumn: SortOrder

	column Capability
		dataType: string
		lineageTag: 77642881-ac74-491c-952d-eadfabcdb2ca
		sourceColumn: Capability
		sortByColumn: SortOrder

	column WhyMissing
		dataType: string
		lineageTag: f68a70ba-a08e-4a34-bc2f-c110a800e6c7
		sourceColumn: WhyMissing

	column HowToClose
		dataType: string
		lineageTag: 70508e3c-7b6e-41eb-89d6-14c0ef35588f
		sourceColumn: HowToClose

	partition AgentGap = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SortOrder = Int64.Type, Capability = text, WhyMissing = text, HowToClose = text],
				        {
				            { 1, "Per-conversation telemetry", "Agent 365 reports message and session counts per agent. Resource Graph only exposes a lastUsed timestamp.", "CLOSED - Purview CopilotInteraction audit records give per-turn, per-thread, per-user detail for every Copilot surface. See the Copilot interactions page." },
				            { 2, "Agent Builder usage of any kind", "Declarative agents run in the Microsoft 365 Copilot host, not the Power Platform runtime. Verified: 0 of 166 Agent Builder agents emit a Power Platform usage record.", "CLOSED - the unified audit log records every declarative-agent turn under AppIdentity Copilot.Studio.Declarative.T_<titleId>, which joins straight to the inventory's TitleId." },
				            { 3, "Per-user adoption", "Who is using which agent.", "CLOSED - the audit record carries the requesting user's UPN, so per-user adoption is available for every agent and for base M365 Copilot." },
				            { 4, "Agent identity / Entra Agent ID", "Agent 365 surfaces agent identities as first-class directory objects.", "Partially covered: entraAppId is captured per agent, and creator/owner GUIDs are already resolved to real names via Graph directoryObjects/getByIds. Join to Entra service principals for sign-in logs." },
				            { 5, "DLP policy violations", "Agent 365 flags policy breaches.", "Power Platform DLP policies via the BAP API, joined to the connector fact table already in this model." },
				            { 6, "Foundry agent-level inventory", "Individual agents inside a Foundry project.", "Foundry data-plane /assistants API per project endpoint; needs per-project RBAC and the real project endpoint." },
				            { 7, "Teams / M365 publication state", "Whether an agent is published to the Teams app catalog.", "Graph /appCatalogs/teamsApps with AppCatalog.Read.All via an app registration." },
				            { 8, "Lifecycle enforcement", "Agent 365 can block, quarantine and retire agents.", "Not closable read-only. Power Platform admin PowerShell can disable agents, but there is no equivalent governance surface." }
				        }
				    )
				in
				    Source

