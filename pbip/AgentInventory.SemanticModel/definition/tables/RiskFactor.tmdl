/// The risk-scoring rubric applied to every agent by the collector.
table RiskFactor
	lineageTag: d9e768d4-d9a5-4f96-9e0c-b9185857ca3b

	column SortOrder
		dataType: int64
		isHidden
		lineageTag: aa2fe0d2-1191-4d90-b77d-901e28ad9b79
		sourceColumn: SortOrder

	column RiskFactor
		dataType: string
		lineageTag: 8a291b08-fe66-446a-8c17-16747e98dd50
		sourceColumn: RiskFactor
		sortByColumn: SortOrder

	column Score
		dataType: int64
		lineageTag: 4135eb2f-5d8f-435c-b397-72109182cfba
		sourceColumn: Score

	column Rationale
		dataType: string
		lineageTag: 003e86eb-71cd-4708-a235-062716b879c8
		sourceColumn: Rationale

	partition RiskFactor = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SortOrder = Int64.Type, RiskFactor = text, Score = Int64.Type, Rationale = text],
				        {
				            { 1, "No authentication configured", 3, "The agent can be reached anonymously." },
				            { 2, "Agent is quarantined", 3, "Already flagged by the platform as unsafe." },
				            { 3, "Shared with the entire tenant", 2, "Every user in the tenant can see and run it." },
				            { 4, "Shared tenant-wide and never used", 1, "Broad exposure with no offsetting business value." },
				            { 5, "Web search enabled on knowledge", 1, "Can reach content outside the tenant boundary." },
				            { 6, "Uses one or more connectors", 1, "Has a path to external or line-of-business data." },
				            { 7, "Connected to other agents", 1, "Can delegate work, widening the blast radius." }
				        }
				    )
				in
				    Source

