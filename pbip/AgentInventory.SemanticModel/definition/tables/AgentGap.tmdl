/// Agent 365 capability coverage: what this solution already closes, what it partly covers, and what a licence would still add.
table AgentGap
	lineageTag: 6ff7935b-33a2-4947-81b6-bc1ac1f807fc

	column SortOrder
		dataType: int64
		isHidden
		lineageTag: 68a9c46b-2417-4d6d-a457-2d5b437ca395
		sourceColumn: SortOrder

	column Capability
		dataType: string
		lineageTag: e94dcc3b-d5be-4b1f-ad74-7b783841e0c7
		sourceColumn: Capability
		sortByColumn: SortOrder

	column Status
		dataType: string
		lineageTag: 3a7f1c62-9d84-4e11-b5a3-77c0e91d4b28
		sourceColumn: Status

	column WhyMissing
		dataType: string
		lineageTag: e1e70e0c-2a2d-49fb-b8cc-5566da27efc8
		sourceColumn: WhyMissing

	column HowToClose
		dataType: string
		lineageTag: b9683099-479a-43fe-b636-02664c85a325
		sourceColumn: HowToClose

	partition AgentGap = m
		mode: import
		source =
				let
				    Source = #table(
				        type table [SortOrder = Int64.Type, Status = text, Capability = text, WhyMissing = text, HowToClose = text],
				        {
				            { 1, "Open", "Agent identity / Entra Agent ID", "Agent 365 surfaces agent identities as first-class directory objects.", "Partly covered: entraAppId is captured per agent, and creator/owner GUIDs are already resolved to real names via Graph directoryObjects/getByIds. Join to Entra service principals for sign-in logs." },
				            { 2, "Open", "DLP policy violations", "Agent 365 flags policy breaches.", "Power Platform DLP policies via the BAP API, joined to the connector fact table already in this model." },
				            { 3, "Open", "Foundry agent-level inventory", "Individual agents inside a Foundry project.", "Foundry data-plane /assistants API per project endpoint; needs per-project RBAC and the real project endpoint." },
				            { 4, "Open", "Teams / M365 publication state", "Whether an agent is published to the Teams app catalog.", "Graph /appCatalogs/teamsApps with AppCatalog.Read.All via an app registration." },
				            { 5, "Open", "Lifecycle enforcement", "Agent 365 can block, quarantine and retire agents.", "Not closable read-only. Power Platform admin PowerShell can disable agents, but there is no equivalent governance surface." },
				            { 6, "Closed", "SharePoint agent inventory", "SharePoint agents are .agent files in document libraries, not Power Platform resources, so Azure Resource Graph cannot enumerate them.", "Closed by SharePointAgentLogging. A daily Purview sharePointFileOperation query for .agent reconstructs the latest observed state per ListItemUniqueId and lands it in Dataverse. FnSpo decodes each SPO_ usage identity to the same item GUID, so names, sites, URLs and usage join exactly. This is an observed-retention inventory: a file with no operation inside the configured audit window remains invisible." },
				            { 7, "Closed", "Per-conversation telemetry", "Resource Graph exposes only a lastUsed timestamp, so message and session counts per agent are invisible to it.", "Closed by the Purview CopilotInteraction audit records, which give per-turn, per-thread, per-user detail for every Copilot surface. See the Copilot interactions page." },
				            { 8, "Closed", "Agent Builder usage", "Declarative agents run in the Microsoft 365 Copilot host, not the Power Platform runtime. Verified: 0 of 166 Agent Builder agents emit a Power Platform usage record.", "Closed by the unified audit log, which records every declarative-agent turn under AppIdentity Copilot.Studio.Declarative.T_<titleId>, joining straight to the inventory TitleId." },
				            { 9, "Closed", "Per-user adoption", "Resource Graph does not record who used an agent.", "Closed by the audit record, which carries the requesting user UPN, so per-user adoption is available for every agent and for base M365 Copilot." },
				            { 10, "Closed", "Named knowledge sources", "Resource Graph carries knowledge counts by type only - no URL appears anywhere in an agent properties.", "Closed for Copilot Studio by the knowledge sweep: botcomponents (componenttype 16) read from every environment Dataverse and republished into the one environment the model reads. 4,324 named sources across 515 environments, naming 3,097 agents, swept from all 742 environments the sweep identity can reach. Agent Builder stays uncovered because those agents are never stored in Dataverse. The page carries the sweep date and flags it STALE past a week - a dataset refresh proves the table was read, not that the names are current." }
				        }
				    )
				in
				    Source
