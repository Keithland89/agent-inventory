/// The AI tooling watchlist this solution hunts for. Shown in the report so the Shadow AI page states
/// what was looked for even when nothing is found - a blank result then reads as "none present" rather
/// than "nothing was checked". Generated from ShadowAiWatchlist, so it can never drift from the queries.
/// Generated from the watchlist, so it needs no data source and is identical in both lanes:
/// the local report states what was hunted for even with no collector output present.
table ShadowAiCatalog
	lineageTag: fb5aa842-805b-4da2-a379-fbdb03ba76d0

	column Category
		dataType: string
		lineageTag: 001098ba-45df-4786-a83c-222ae55dd217
		sourceColumn: Category

	column Vendor
		dataType: string
		lineageTag: 08eda0a3-138c-4bc5-a282-d0fd90756d27
		sourceColumn: Vendor

	column AppName
		dataType: string
		lineageTag: 61dd4cf3-075e-4f82-9d60-8608a85f55c7
		sourceColumn: AppName

	column Posture
		dataType: string
		lineageTag: 28c2f4a9-2faf-4e07-8eab-585aade355ab
		sourceColumn: Posture

	/// Term matched against DeviceTvmSoftwareInventory SoftwareName.
	column SoftwareMatch
		dataType: string
		lineageTag: 1e0cddfd-76b7-4004-91e4-82b071d3936d
		sourceColumn: SoftwareMatch

	/// Exact file name matched against DeviceProcessEvents FileName.
	column ProcessName
		dataType: string
		lineageTag: 899399c2-9415-4dc5-bec8-58770aa3cbcf
		sourceColumn: ProcessName

	/// Term matched against DeviceNetworkEvents RemoteUrl.
	column Domain
		dataType: string
		lineageTag: 89de9737-b48e-434b-b13f-c757b649a531
		sourceColumn: Domain

	partition ShadowAiCatalog = m
		mode: import
		source =
				let
				    Source = Table.SelectColumns(ShadowAiWatchlist, {"Category", "Vendor", "AppName", "Posture", "SoftwareMatch", "ProcessName", "Domain"})
				in
				    Source
