				                RawUsage = FnArg("PowerPlatformResources | where type =~ 'microsoft.powerplatformusage/usagerecords' | where isnotnull(properties) | project ResourceKey = tostring(properties.resourceId), LastUsedRaw = tostring(properties.lastUsed) | where isnotempty(ResourceKey) and isnotempty(LastUsedRaw) | summarize LastUsedRaw = max(LastUsedRaw) by ResourceKey | order by ResourceKey asc"),
				                RawEnvs = FnArg("PowerPlatformResources | where type =~ 'microsoft.powerplatform/environments' | extend p = properties | project EnvironmentId = tostring(name), EnvironmentName = tostring(p.displayName), Region = tostring(location), EnvironmentType = tostring(p.environmentType), IsManaged = tobool(p.isManaged), EnvironmentGroupId = tostring(p.environmentGroupId), CreatedAt = tostring(p.createdAt), LastModifiedAt = tostring(p.lastModifiedAt), CreatedBy = tostring(p.createdBy) | order by EnvironmentId asc"),
				                tAgents = FnRecordsToTable(RawAgents, {"AgentKey", "AgentId", "AgentName", "AuthoringSurface", "EnvironmentId", "Region", "SchemaName", "Orchestration", "Model", "Authentication", "CreatedAt", "LastPublishedAt", "IsQuarantined", "IsManaged", "IsGithubCopilotAgent", "IsCLIAgent", "WebSearchEnabled", "Channels", "ChannelCount", "TopicCount", "ToolCount", "KnowledgeCount", "ConnectedAgentCount", "ConnectorCount", "ConnectorOpsCount", "FlowCount", "SharedUserCount", "SharedGroupCount", "SharedTenantWide", "EditorUserCount", "OwnerId", "CreatedBy", "EntraAppId", "TitleId", "QuarantinedAt", "EntraAgentId", "EntraAgentBlueprintId", "Harness", "InstructionsCharCount", "GraphConnectorCount", "SharePointSiteCount", "PublicSiteCount", "FileKnowledgeCount", "DataverseSourceCount", "KnowledgeTypes"}),
				                tUsage = FnRecordsToTable(RawUsage, {"ResourceKey", "LastUsedRaw"}),
				                tEnvs = FnRecordsToTable(RawEnvs, {"EnvironmentId", "EnvironmentName", "EnvironmentType"}),
				                JoinUsage = Table.NestedJoin(tAgents, {"AgentId"}, tUsage, {"ResourceKey"}, "u", JoinKind.LeftOuter),
				                ExpUsage = Table.ExpandTableColumn(JoinUsage, "u", {"LastUsedRaw"}, {"LastUsedRaw"}),
				                JoinEnv = Table.NestedJoin(ExpUsage, {"EnvironmentId"}, tEnvs, {"EnvironmentId"}, "e", JoinKind.LeftOuter),
				                ExpEnv = Table.ExpandTableColumn(JoinEnv, "e", {"EnvironmentName", "EnvironmentType"}, {"EnvironmentName", "EnvironmentType"}),
				                FillEnv = Table.ReplaceValue(ExpEnv, each [EnvironmentName], each if [EnvironmentName] = null or [EnvironmentName] = "" then "Unlisted: " & [EnvironmentId] else [EnvironmentName], Replacer.ReplaceValue, {"EnvironmentName"}),
				                FillEnvType = Table.ReplaceValue(FillEnv, each [EnvironmentType], each if [EnvironmentType] = null or [EnvironmentType] = "" then "Unknown" else [EnvironmentType], Replacer.ReplaceValue, {"EnvironmentType"}),
				                FillModel = Table.ReplaceValue(FillEnvType, each [Model], each if [Model] = null or [Model] = "" then "Not specified" else [Model], Replacer.ReplaceValue, {"Model"}),
				                Converted = Table.TransformColumns(FillModel, {{"CreatedAt", FnToDateTime, type datetime}, {"LastPublishedAt", FnToDateTime, type datetime}, {"LastUsedRaw", FnToDateTime, type datetime}, {"QuarantinedAt", FnToDateTime, type datetime}}),
				                Bools = Table.TransformColumns(Converted, {{"IsQuarantined", FnToLogical, type logical}, {"IsManaged", FnToLogical, type logical}, {"IsGithubCopilotAgent", FnToLogical, type logical}, {"IsCLIAgent", FnToLogical, type logical}, {"WebSearchEnabled", FnToLogical, type logical}, {"SharedTenantWide", FnToLogical, type logical}}),
				                Renamed = Table.RenameColumns(Bools, {{"LastUsedRaw", "LastUsed"}}),
				                Typed = Table.TransformColumnTypes(Renamed, {{"EnvironmentName", type text}, {"EnvironmentType", type text}}),
				                RawFoundry = FnArg("resources | where type startswith 'microsoft.cognitiveservices' or type startswith 'microsoft.machinelearningservices' | where (type endswith 'accounts/projects') or (tostring(kind) == 'Project') | extend p = properties | project AgentKey = tostring(id), AgentId = tostring(id), AgentName = tostring(split(name, '/')[-1]), EnvironmentId = tostring(subscriptionId), EnvironmentName = iff(name has '/', tostring(split(name, '/')[0]), tostring(name)), Region = tostring(location), CreatedAt = tostring(p.createdAtDate) | order by AgentKey asc"),
				                FoundryRecords = List.Transform(RawFoundry, each [
				                    AgentKey = Record.FieldOrDefault(_, "AgentKey", null),
				                    AgentId = Record.FieldOrDefault(_, "AgentId", null),
				                    AgentName = Record.FieldOrDefault(_, "AgentName", null),
				                    AuthoringSurface = "Azure AI Foundry",
				                    EnvironmentId = Record.FieldOrDefault(_, "EnvironmentId", null),
				                    Region = Record.FieldOrDefault(_, "Region", null),
				                    SchemaName = null,
				                    Orchestration = "Generative",
				                    Model = "See deployments",
				                    Authentication = "Microsoft Entra",
				                    CreatedAt = FnToDateTime(Record.FieldOrDefault(_, "CreatedAt", null)),
				                    LastPublishedAt = null,
				                    IsQuarantined = false,
				                    IsManaged = true,
				                    IsGithubCopilotAgent = false,
				                    IsCLIAgent = false,
				                    WebSearchEnabled = false,
				                    Channels = "API / SDK",
				                    ChannelCount = 1,
				                    TopicCount = 0,
				                    ToolCount = 0,
				                    KnowledgeCount = 0,
				                    ConnectedAgentCount = 0,
				                    ConnectorCount = 0,
				                    ConnectorOpsCount = 0,
				                    FlowCount = 0,
				                    SharedUserCount = 0,
				                    SharedGroupCount = 0,
				                    SharedTenantWide = false,
				                    EditorUserCount = 0,
				                    OwnerId = null,
				                    CreatedBy = null,
				                    EntraAppId = null,
				                    TitleId = null,
				                    QuarantinedAt = null,
				                    EntraAgentId = null,
				                    EntraAgentBlueprintId = null,
				                    Harness = null,
				                    InstructionsCharCount = 0,
				                    GraphConnectorCount = 0,
				                    SharePointSiteCount = 0,
				                    PublicSiteCount = 0,
				                    FileKnowledgeCount = 0,
				                    DataverseSourceCount = 0,
				                    KnowledgeTypes = null,
				                    LastUsed = null,
				                    EnvironmentName = Record.FieldOrDefault(_, "EnvironmentName", null),
				                    EnvironmentType = "Azure subscription"
				                ]),
				                tFoundry = FnRecordsToTable(FoundryRecords, {"AgentKey", "AgentId", "AgentName", "AuthoringSurface", "EnvironmentId", "Region", "SchemaName", "Orchestration", "Model", "Authentication", "CreatedAt", "LastPublishedAt", "IsQuarantined", "IsManaged", "IsGithubCopilotAgent", "IsCLIAgent", "WebSearchEnabled", "Channels", "ChannelCount", "TopicCount", "ToolCount", "KnowledgeCount", "ConnectedAgentCount", "ConnectorCount", "ConnectorOpsCount", "FlowCount", "SharedUserCount", "SharedGroupCount", "SharedTenantWide", "EditorUserCount", "OwnerId", "CreatedBy", "EntraAppId", "TitleId", "QuarantinedAt", "EntraAgentId", "EntraAgentBlueprintId", "Harness", "InstructionsCharCount", "GraphConnectorCount", "SharePointSiteCount", "PublicSiteCount", "FileKnowledgeCount", "DataverseSourceCount", "KnowledgeTypes", "LastUsed", "EnvironmentName", "EnvironmentType"}),
				                Combined = Table.Combine({Typed, tFoundry}),
				                Unified = FnDistinctKey(Combined, "AgentKey"),
				                Today = DateTime.LocalNow(),
				                WithPlatform = Table.AddColumn(Unified, "Platform", each
				                    if [AuthoringSurface] = "Copilot Studio Lite" then "M365 Copilot Agent Builder"
				                    else if [AuthoringSurface] = null or [AuthoringSurface] = "" then "Copilot Studio"
				                    else [AuthoringSurface], type text),
				                WithPub = Table.AddColumn(WithPlatform, "IsPublished", each [LastPublishedAt] <> null, type logical),
				                WithDays = Table.AddColumn(WithPub, "DaysSinceLastUse", each if [LastUsed] = null then null else Duration.Days(Today - [LastUsed]), Int64.Type),
				                WithAge = Table.AddColumn(WithDays, "AgeDays", each if [CreatedAt] = null then null else Duration.Days(Today - [CreatedAt]), Int64.Type),
				                WithMonth = Table.AddColumn(WithAge, "CreatedMonth", each if [CreatedAt] = null then null else Date.ToText(DateTime.Date([CreatedAt]), "yyyy-MM"), type text),
				                WithStatus = Table.AddColumn(WithMonth, "ActivityStatus", each
				                    if [DaysSinceLastUse] = null then "No usage signal"
				                    else if [DaysSinceLastUse] <= 7 then "Active (7d)"
				                    else if [DaysSinceLastUse] <= 30 then "Active (30d)"
				                    else if [DaysSinceLastUse] <= 90 then "Idle (90d)"
				                    else "Dormant (90d+)", type text),
				                WithRiskList = Table.AddColumn(WithStatus, "RiskFactorList", each List.RemoveNulls({
				                    (if [Authentication] = null or [Authentication] = "" or [Authentication] = "None" or [Authentication] = "No authentication" then "No authentication configured (+3)" else null),
				                    (if [IsQuarantined] = true then "Agent is quarantined (+3)" else null),
				                    (if [SharedTenantWide] = true then "Shared with the entire tenant (+2)" else null),
				                    (if [SharedTenantWide] = true and [LastUsed] = null then "Shared tenant-wide and never used (+1)" else null),
				                    (if [WebSearchEnabled] = true then "Web search enabled on knowledge (+1)" else null),
				                    (if [ConnectorCount] <> null and [ConnectorCount] > 0 then "Uses one or more connectors (+1)" else null),
				                    (if [ConnectedAgentCount] <> null and [ConnectedAgentCount] > 0 then "Connected to other agents (+1)" else null)
				                }), type list),
				                WithReasons = Table.AddColumn(WithRiskList, "RiskReasons", each if List.Count([RiskFactorList]) = 0 then "No risk factors detected" else Text.Combine([RiskFactorList], "; "), type text),
				                WithFactorCount = Table.AddColumn(WithReasons, "RiskFactorCount", each List.Count([RiskFactorList]), Int64.Type),
				                WithRisk = Table.AddColumn(WithFactorCount, "RiskScore", each
				                    (if [SharedTenantWide] = true then 2 else 0)
				                    + (if [IsQuarantined] = true then 3 else 0)
				                    + (if [Authentication] = null or [Authentication] = "" or [Authentication] = "None" or [Authentication] = "No authentication" then 3 else 0)
				                    + (if [WebSearchEnabled] = true then 1 else 0)
				                    + (if [ConnectorCount] <> null and [ConnectorCount] > 0 then 1 else 0)
				                    + (if [ConnectedAgentCount] <> null and [ConnectedAgentCount] > 0 then 1 else 0)
				                    + (if [SharedTenantWide] = true and [LastUsed] = null then 1 else 0), Int64.Type),
				                WithBand = Table.AddColumn(WithRisk, "RiskBand", each if [RiskScore] >= 5 then "High" else if [RiskScore] >= 3 then "Medium" else "Low", type text),
				                Ordered = Table.SelectColumns(WithBand, {"AgentKey", "AgentId", "AgentName", "Platform", "AuthoringSurface", "EnvironmentId", "EnvironmentName", "EnvironmentType", "Region", "SchemaName", "Orchestration", "Model", "Authentication", "CreatedAt", "LastPublishedAt", "LastUsed", "IsPublished", "IsQuarantined", "IsManaged", "IsGithubCopilotAgent", "IsCLIAgent", "WebSearchEnabled", "Channels", "ChannelCount", "TopicCount", "ToolCount", "KnowledgeCount", "ConnectedAgentCount", "ConnectorCount", "ConnectorOpsCount", "FlowCount", "SharedUserCount", "SharedGroupCount", "SharedTenantWide", "EditorUserCount", "OwnerId", "CreatedBy", "EntraAppId", "TitleId", "QuarantinedAt", "EntraAgentId", "EntraAgentBlueprintId", "Harness", "KnowledgeTypes", "InstructionsCharCount", "GraphConnectorCount", "SharePointSiteCount", "PublicSiteCount", "FileKnowledgeCount", "DataverseSourceCount", "DaysSinceLastUse", "AgeDays", "CreatedMonth", "ActivityStatus", "RiskScore", "RiskBand", "RiskFactorCount", "RiskReasons"}, MissingField.UseNull),
				                Retyped = Table.TransformColumnTypes(Ordered, {{"AgentKey", type text}, {"AgentId", type text}, {"AgentName", type text}, {"Platform", type text}, {"AuthoringSurface", type text}, {"EnvironmentId", type text}, {"EnvironmentName", type text}, {"EnvironmentType", type text}, {"Region", type text}, {"SchemaName", type text}, {"Orchestration", type text}, {"Model", type text}, {"Authentication", type text}, {"CreatedAt", type datetime}, {"LastPublishedAt", type datetime}, {"LastUsed", type datetime}, {"IsPublished", type logical}, {"IsQuarantined", type logical}, {"IsManaged", type logical}, {"IsGithubCopilotAgent", type logical}, {"IsCLIAgent", type logical}, {"WebSearchEnabled", type logical}, {"Channels", type text}, {"ChannelCount", Int64.Type}, {"TopicCount", Int64.Type}, {"ToolCount", Int64.Type}, {"KnowledgeCount", Int64.Type}, {"ConnectedAgentCount", Int64.Type}, {"ConnectorCount", Int64.Type}, {"ConnectorOpsCount", Int64.Type}, {"FlowCount", Int64.Type}, {"SharedUserCount", Int64.Type}, {"SharedGroupCount", Int64.Type}, {"SharedTenantWide", type logical}, {"EditorUserCount", Int64.Type}, {"OwnerId", type text}, {"CreatedBy", type text}, {"EntraAppId", type text}, {"TitleId", type text}, {"QuarantinedAt", type datetime}, {"EntraAgentId", type text}, {"EntraAgentBlueprintId", type text}, {"Harness", type text}, {"KnowledgeTypes", type text}, {"InstructionsCharCount", Int64.Type}, {"GraphConnectorCount", Int64.Type}, {"SharePointSiteCount", Int64.Type}, {"PublicSiteCount", Int64.Type}, {"FileKnowledgeCount", Int64.Type}, {"DataverseSourceCount", Int64.Type}, {"DaysSinceLastUse", Int64.Type}, {"AgeDays", Int64.Type}, {"CreatedMonth", type text}, {"ActivityStatus", type text}, {"RiskScore", Int64.Type}, {"RiskBand", type text}, {"RiskFactorCount", Int64.Type}, {"RiskReasons", type text}}),
				                WithCreatedDate = Table.AddColumn(Retyped, "CreatedDate", each if [CreatedAt] = null then null else DateTime.Date([CreatedAt]), type date),
				                WithLastUsedDate = Table.AddColumn(WithCreatedDate, "LastUsedDate", each if [LastUsed] = null then null else DateTime.Date([LastUsed]), type date)
				            in
				                WithLastUsedDate
				        else
				            let
				                Source = Csv.Document(File.Contents(DataFolder & "\DimAgent.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				                Headers = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				                // MissingField.UseNull so an extract taken before the newer fields were collected still
				                // loads: the columns arrive blank rather than failing the refresh.
				                Kept = Table.SelectColumns(Headers, {"AgentKey", "AgentId", "AgentName", "Platform", "AuthoringSurface", "EnvironmentId", "EnvironmentName", "EnvironmentType", "Region", "SchemaName", "Orchestration", "Model", "Authentication", "CreatedAt", "LastPublishedAt", "LastUsed", "IsPublished", "IsQuarantined", "IsManaged", "IsGithubCopilotAgent", "IsCLIAgent", "WebSearchEnabled", "Channels", "ChannelCount", "TopicCount", "ToolCount", "KnowledgeCount", "ConnectedAgentCount", "ConnectorCount", "ConnectorOpsCount", "FlowCount", "SharedUserCount", "SharedGroupCount", "SharedTenantWide", "EditorUserCount", "OwnerId", "CreatedBy", "EntraAppId", "TitleId", "DaysSinceLastUse", "AgeDays", "CreatedMonth", "ActivityStatus", "RiskScore", "RiskBand", "RiskFactorCount", "RiskReasons", "EntraAgentId", "EntraAgentBlueprintId", "Harness", "InstructionsCharCount", "GraphConnectorCount", "SharePointSiteCount", "PublicSiteCount", "FileKnowledgeCount", "DataverseSourceCount", "KnowledgeTypes", "QuarantinedAt"}, MissingField.UseNull),
				                Converted = Table.TransformColumns(Kept, {{"CreatedAt", FnToDateTime, type datetime}, {"LastPublishedAt", FnToDateTime, type datetime}, {"LastUsed", FnToDateTime, type datetime}, {"IsPublished", FnToBool, type logical}, {"IsQuarantined", FnToBool, type logical}, {"IsManaged", FnToBool, type logical}, {"IsGithubCopilotAgent", FnToBool, type logical}, {"IsCLIAgent", FnToBool, type logical}, {"WebSearchEnabled", FnToBool, type logical}, {"ChannelCount", FnToInt, Int64.Type}, {"TopicCount", FnToInt, Int64.Type}, {"ToolCount", FnToInt, Int64.Type}, {"KnowledgeCount", FnToInt, Int64.Type}, {"ConnectedAgentCount", FnToInt, Int64.Type}, {"ConnectorCount", FnToInt, Int64.Type}, {"ConnectorOpsCount", FnToInt, Int64.Type}, {"FlowCount", FnToInt, Int64.Type}, {"SharedUserCount", FnToInt, Int64.Type}, {"SharedGroupCount", FnToInt, Int64.Type}, {"SharedTenantWide", FnToBool, type logical}, {"EditorUserCount", FnToInt, Int64.Type}, {"DaysSinceLastUse", FnToInt, Int64.Type}, {"AgeDays", FnToInt, Int64.Type}, {"RiskScore", FnToInt, Int64.Type}, {"RiskFactorCount", FnToInt, Int64.Type}, {"InstructionsCharCount", FnToInt, Int64.Type}, {"GraphConnectorCount", FnToInt, Int64.Type}, {"SharePointSiteCount", FnToInt, Int64.Type}, {"PublicSiteCount", FnToInt, Int64.Type}, {"FileKnowledgeCount", FnToInt, Int64.Type}, {"DataverseSourceCount", FnToInt, Int64.Type}, {"QuarantinedAt", FnToDateTime, type datetime}}),
				                Typed = Table.TransformColumnTypes(Converted, {{"AgentKey", type text}, {"AgentId", type text}, {"AgentName", type text}, {"Platform", type text}, {"AuthoringSurface", type text}, {"EnvironmentId", type text}, {"EnvironmentName", type text}, {"EnvironmentType", type text}, {"Region", type text}, {"SchemaName", type text}, {"Orchestration", type text}, {"Model", type text}, {"Authentication", type text}, {"Channels", type text}, {"OwnerId", type text}, {"CreatedBy", type text}, {"EntraAppId", type text}, {"TitleId", type text}, {"CreatedMonth", type text}, {"ActivityStatus", type text}, {"RiskBand", type text}, {"RiskReasons", type text}, {"EntraAgentId", type text}, {"EntraAgentBlueprintId", type text}, {"Harness", type text}, {"KnowledgeTypes", type text}}),
				                WithCreatedDate = Table.AddColumn(Typed, "CreatedDate", each if [CreatedAt] = null then null else DateTime.Date([CreatedAt]), type date),
				                WithLastUsedDate = Table.AddColumn(WithCreatedDate, "LastUsedDate", each if [LastUsed] = null then null else DateTime.Date([LastUsed]), type date)
				            in
				                WithLastUsedDate
				in
				    Source
