	column KnowledgeTypes
		dataType: string
		lineageTag: 93e14083-6584-4849-bcdb-9357e20ef21f
		summarizeBy: none
		sourceColumn: KnowledgeTypes

	/// When the agent was quarantined. Blank unless IsQuarantined is true.
	column QuarantinedAt
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 9c133ebc-adf7-40bc-812b-94cbbea91c42
		summarizeBy: none
		sourceColumn: QuarantinedAt

	/// Whether the agent carries any instruction text at all.
	column HasInstructions = 'Agent'[InstructionsCharCount] > 0
		dataType: boolean
		lineageTag: 42e3b5a8-ee58-4cb0-932c-0875476c4aa0
		summarizeBy: none

	/// Number of distinct knowledge kinds attached, derived from KnowledgeTypes.
	column KnowledgeTypeCount = IF ( ISBLANK ( 'Agent'[KnowledgeTypes] ) || 'Agent'[KnowledgeTypes] = "", 0, PATHLENGTH ( SUBSTITUTE ( 'Agent'[KnowledgeTypes], "; ", "|" ) ) )
		dataType: int64
		formatString: #,0
		lineageTag: 4b7e78a0-ed8c-4332-99b6-8fa778072f8f
		summarizeBy: sum

	/// Most recent evidence the agent ran, taking the later of the Power Platform usage record and the last audit-log interaction.
	/// Deliberately avoids CALCULATE. Context transition inside a calculated column takes a dependency on every column of its own table, and DaysSinceLastActivity and ActivityStatus both depend on this one - so CALCULATE ( MAX ( 'Interaction'[CreationTime] ) ) is circular here and silently evaluates to blank, reporting agents with real interactions as unused. MAXX over an explicit FILTER depends only on Agent[AgentKey], so it resolves.
	column LastActivityAt = VAR ArgUse = 'Agent'[LastUsed] VAR K = 'Agent'[AgentKey] VAR Audit = MAXX ( FILTER ( 'Interaction', 'Interaction'[AgentKey] = K ), 'Interaction'[CreationTime] ) RETURN IF ( ISBLANK ( ArgUse ), Audit, IF ( ISBLANK ( Audit ), ArgUse, MAX ( ArgUse, Audit ) ) )
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn:ss
		lineageTag: 26eee146-fef2-4f6c-8556-6723d38e6c2c
		summarizeBy: none

	/// Days since the agent last ran, from either source.
	column DaysSinceLastActivity = IF ( ISBLANK ( 'Agent'[LastActivityAt] ), BLANK ( ), DATEDIFF ( 'Agent'[LastActivityAt], TODAY ( ), DAY ) )
		dataType: int64
		formatString: #,0
		lineageTag: f70cdff4-0daf-43b2-9c11-8aac4f75a4d5
		summarizeBy: sum

	/// Activity from both the Power Platform usage record and the audit log, so an agent with real interactions is never reported as unused.
	column ActivityStatus = VAR D = 'Agent'[DaysSinceLastActivity] RETURN IF ( ISBLANK ( D ), "No usage signal", IF ( D <= 7, "Active (7d)", IF ( D <= 30, "Active (30d)", IF ( D <= 90, "Idle (90d)", "Dormant (90d+)" ) ) ) )
		dataType: string
		lineageTag: 0ca1e80d-de13-4414-8d66-4668b6742d6b
		summarizeBy: none

	/// Groups agents the way the Agent 365 registry does, separating what the organisation built from what Microsoft ships pre-installed.
	column CreatorCategory = VAR blueprint = 'Agent'[EntraAgentBlueprintId] VAR creator = 'Agent'[CreatedByName] RETURN IF ( 'Agent'[IsManaged] && ( ISBLANK ( creator ) || creator = "System / platform" ), "Microsoft", IF ( ISBLANK ( creator ) || creator = "", "Unattributed", IF ( NOT ISBLANK ( blueprint ) && blueprint <> "", "Built from Microsoft blueprint", "Your organization" ) ) )
		dataType: string
		lineageTag: 8bbb383e-9149-4548-a96c-ae86900b0162
		summarizeBy: none

	/// True when the agent reads from at least one Microsoft Graph connector, which widens its reach to indexed third-party content.
	column HasGraphConnector = 'Agent'[GraphConnectorCount] > 0
		dataType: boolean
		lineageTag: c3ab58be-6bb4-4931-8a9a-58bb1cf600e7
		summarizeBy: none

	/// Ownerless agents are the ones nobody can be asked to review, so the registry calls them out separately.
	column HasOwner = NOT ( ISBLANK ( 'Agent'[OwnerName] ) || 'Agent'[OwnerName] = "" )
		dataType: boolean
		lineageTag: b286622d-b37a-4e4c-9941-a90a7b61eca3
		summarizeBy: none

